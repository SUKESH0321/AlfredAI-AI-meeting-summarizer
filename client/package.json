{
  "name": "alfredai-desktop",
  "version": "1.1.020",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "vite",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:start": "electron .",
    "build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.alfredai.app",
    "productName": "AlfredAI-V1.1.020",
    "icon": "public/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "../dist/public",
        "to": "dist/public",
        "filter": [
          "**/*"
        ]
      },
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!.env",
          "!uploads/**",
          "!temp/**",
          "!index.ts"
        ]
      }
    ],
    "win": {
      "icon": "public/icon.ico"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-icon-builder": "^2.0.1",
    "png-to-ico": "^3.0.2",
    "wait-on": "^7.2.0"
  }
}
